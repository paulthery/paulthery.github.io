# Headers for Cloudflare Pages
#
# Syntax note: Pages matches a leading path with `*` wildcards and `:named`
# placeholders. It does NOT expand braces, so a rule like
# `/*.{jpg,png,avif}` matches nothing at all - it looks right and silently
# does nothing. Match a folder prefix or a single extension instead.

# General security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), fullscreen=(self), sync-xhr=()

# Bundled JS and CSS. Safe to freeze: the pages request them with a ?v=
# timestamp, so a new build is a new URL rather than a stale hit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Album media. Deliberately NOT immutable: these filenames carry no version, so
# a replaced image under the same name has to be able to reach visitors. A month
# with revalidation, rather than the year the old brace rule never applied.
/artdirection/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/photography/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Manifest and sitemaps: short, they change with every album edit
/albums.json
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
